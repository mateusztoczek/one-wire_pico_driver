.program onewire
.side_set 1 pindirs

.wrap_target
public get_next_cmd:
    pull block side 0
    out pc, 5 side 0



public read_bit:
    nop side 1 [5]
    nop side 0 [5]
    in pins, 1 side 0 
    set y, 2 side 0 [15]

read_wait_cycle:
    jmp y-- read_wait_cycle side 0 [15]
    push block side 0
    jmp get_next_cmd side 0



public write_bit:
    pull block side 0
    out x, 1 side 0
    jmp !x write_zero side 1 [5]

write_one:
    set y, 2 side 0 [15]

write_one_wait_cycle:
    jmp y-- write_one_wait_cycle side 0 [15]
    jmp get_next_cmd side 0

write_zero:
    set y, 2 side 1 [5]

write_zero_wait_cycle:
    jmp y-- write_zero_wait_cycle side 1 [15]
    nop side 0 [8]
    jmp get_next_cmd side 0



public reset:
    set y, 28 side 1 [15]

reset_low:
    jmp y-- reset_low side 1 [15]
    set y, 2 side 0 [15]

reset_wait_cycle:
    jmp y-- reset_wait_cycle side 0 [15]
    nop side 0 [5]
    in pins, 1 side 0
    set y, 23 side 0 [15]

reset_finish:
    jmp y-- reset_finish side 0 [15]
    nop side 0 [7]
    push block side 0
    jmp get_next_cmd side 0
.wrap